# Copiá este archivo como ".env" y completá los valores reales.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=

# Clave secreta con la que se firman los tokens JWT (una frase larga y difícil de adivinar)
JWT_SECRET=

# Credenciales de Cloudinary (panel de Cloudinary → Settings → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Puerto donde escucha el back (opcional, por defecto 3000)
PORT=3000
